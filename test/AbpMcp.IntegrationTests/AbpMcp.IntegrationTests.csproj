<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AbpMcp.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Test fixtures intentionally include sample DTOs without XML docs. -->
    <NoWarn>$(NoWarn);CS1591;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AbpMcp\AbpMcp.csproj" />
    <!-- End-to-end tests host the Library sample on an in-memory TestServer and drive it with the SDK's MCP client. -->
    <ProjectReference Include="..\..\samples\AbpMcp.Sample\AbpMcp.Sample.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="FluentAssertions" Version="6.12.*" />

    <PackageReference Include="Volo.Abp.TestBase" Version="$(AbpHostVersion)" />
    <PackageReference Include="Volo.Abp.Autofac" Version="$(AbpHostVersion)" />
    <PackageReference Include="Volo.Abp.BackgroundJobs.Abstractions" Version="$(AbpHostVersion)" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore" Version="$(AbpHostVersion)" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="$(EfCoreVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="$(MsExtVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
