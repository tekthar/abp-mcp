<Project>
  <PropertyGroup>
    <!-- .NET 10 / ABP 10 only. net9.0 (ABP 9.2) support was dropped in 0.4.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Dependency versions. ABP 10.1 is the floor (the version the first production consumer runs);
       raising it raises the minimum ABP every consumer must run. Referenced as $(AbpVersion)/
       $(EfCoreVersion)/$(MsExtVersion) from each csproj so there is one place to bump. -->
  <PropertyGroup>
    <AbpVersion>10.1.*</AbpVersion>
    <EfCoreVersion>10.0.*</EfCoreVersion>
    <MsExtVersion>10.0.*</MsExtVersion>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>tekthar and abp-mcp contributors</Authors>
    <Company>tekthar</Company>
    <RepositoryUrl>https://github.com/tekthar/abp-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tekthar/abp-mcp</PackageProjectUrl>
    <!-- Tags are how nuget.org filtered search finds this. The two that matter most for
         our audience are "abp" and "mcp"; the rest are second-order matches. -->
    <PackageTags>abp;abp-framework;mcp;model-context-protocol;claude;ai;agents;dotnet;aspnetcore</PackageTags>
    <PackageReleaseNotes>See https://github.com/tekthar/abp-mcp/releases for release notes.</PackageReleaseNotes>
    <Version>0.4.0</Version>
  </PropertyGroup>
</Project>
